# 独立加密配置；复制为项目根目录 .env.crypt 后填写真实值。
# 注意：本文件通过 INI 解析，RSA PEM 必须先进行单行 Base64 编码。

# 默认驱动：aes / rsa / sm4 / hmac
CRYPT_TYPE=aes

# 对称加密及签名密钥
CRYPT_AES_KEY=
CRYPT_AES_CIPHER=aes-256-gcm
CRYPT_SM4_KEY=
CRYPT_HMAC_KEY=
CRYPT_HMAC_ALGO=sha256

# RSA 完整 PEM 内容的 Base64 编码（不是 PEM 文件路径）
CRYPT_RSA_PUBLIC_KEY_B64=
CRYPT_RSA_PRIVATE_KEY_B64=
CRYPT_RSA_PASSPHRASE=
CRYPT_OPENSSL_CNF=

# API 信封加密与验签
CRYPT_API_SIGN_SECRET=
CRYPT_API_TIME_TOLERANCE=60000
CRYPT_API_NONCE_EXPIRE=120